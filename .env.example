# --- Required ---
# Postgres connection string (TLS required in production)
DATABASE_URL=postgresql://lwc:lwc@localhost:5433/lwc

# >= 32 chars, secret used by Payload to sign JWTs and encrypt cookies
PAYLOAD_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Site base URL (used for ICS feed, OG, sitemap)
SITE_URL=http://localhost:3000

# IP hash salt — must be unique per env. Used to one-way hash IPs before logging/storage.
IP_HASH_SALT=replace-me-with-a-long-random-string-16plus

# --- Seed (first run only) ---
SEED_ADMIN_EMAIL=admin@dmcschools.org
SEED_ADMIN_PASSWORD=ChangeMeNow_VeryStrong_2026

# --- Email (Resend in prod; MailHog in dev via SMTP_URL) ---
# Production: get key from resend.com after DNS verification
RESEND_API_KEY=
# Verified sender (must match Resend domain in prod)
EMAIL_FROM=lionswrestling@dmcschools.org
EMAIL_REPLY_TO=lionswrestling@dmcschools.org
# Dev fallback (docker-compose mailhog)
SMTP_URL=smtp://localhost:1025

# --- Rate limiting (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Turnstile (Cloudflare bot defense) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Media (Cloudflare R2 in prod; local filesystem in dev) ---
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=
