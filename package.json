{
  "name": "lwc",
  "version": "0.1.0",
  "private": true,
  "description": "DMC Lions Wrestling Club website + admin",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "format": "prettier --write .",
    "postinstall": "node scripts/patch-deps.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@next/env": "^16.2.6",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/drizzle": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.4",
    "@vercel/og": "^0.6.5",
    "add-to-calendar-button-react": "^2.8.10",
    "argon2": "^0.41.1",
    "dompurify": "^3.2.3",
    "file-type": "^19.6.0",
    "graphql": "^16.10.0",
    "jsdom": "^25.0.1",
    "next": "16.2.6",
    "otplib": "^12.0.1",
    "payload": "3.84.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-hook-form": "^7.54.2",
    "resend": "^4.0.1",
    "sharp": "0.33.5",
    "yet-another-react-lightbox": "^3.21.7",
    "zod": "^3.24.1",
    "zxcvbn": "^4.4.2"
  },
  "pnpm": {
    "overrides": {
      "@next/env": "15.4.11"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.49.1",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-security": "^3.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
